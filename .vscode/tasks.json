{
    "tasks": [
        {
            // Create build folder for .out files
            "type": "shell",
            "label": "Create build folder",
            "command": "mkdir -p \"${fileDirname}/build\""
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-pedantic-errors", // Enforce C++ standard compliance
                "-Wall", // Common warnings (despite the name, not all)
                "-Weffc++", // Effective C++ style warnings (GCC only, ignored by clang)
                "-Wextra", // Additional warnings not covered by -Wall
                "-Wconversion", // Warn on implicit conversions that may lose data
                "-Wsign-conversion", // Warn on implicit signed/unsigned conversions
                "-std=c++20", // Use the C++20 standard
                "${file}",
                "-o",
                "${fileDirname}/build/${fileBasenameNoExtension}.out" // add ending to compiled files for gitignore
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "Create build folder",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
